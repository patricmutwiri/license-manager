# Environment Variables for License Manager
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real secrets!

# OAuth2 - Google
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=your-google-client-id-here
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# OAuth2 - GitHub
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_ID=your-github-client-id-here
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_SECRET=your-github-client-secret-here

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/license_manager
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-secure-password
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Mail Configuration
SMTP_MAIL_HOST=mail.example.com
SMTP_MAIL_POST=465
SMTP_MAIL_USERNAME=your-email@example.com
SMTP_MAIL_PASSWORD=your-app-password
SMTP_MAIL_AUTH=true
SMTP_MAIL_TLS=true
SMTP_MAIL_FROM=noreply@example.com

# Server
PORT=8080
